{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "node"],
    "paths": {
      "gofish-graphics": ["../packages/gofish-graphics/src/lib.ts"],
      // The harness imports the widget's Arrow decode; apache-arrow 14's
      // package.json "exports" names no types, so point at its browser ones.
      "apache-arrow": [
        "../packages/gofish-python/node_modules/apache-arrow/Arrow.dom.d.ts"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "harness/**/*.ts",
    "bench/**/*.ts",
    "playwright.config.ts",
    "../packages/gofish-graphics/src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "tmp", "scripts/cf-functions"]
}
