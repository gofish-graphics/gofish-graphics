{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "node"],
    "paths": {
      "gofish-graphics": ["../packages/gofish-graphics/src/lib.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "harness/**/*.ts",
    "bench/**/*.ts",
    "playwright.config.ts",
    "../packages/gofish-graphics/src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "tmp", "scripts/cf-functions"]
}
