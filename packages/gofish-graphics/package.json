{
  "name": "gofish-graphics",
  "version": "0.1.0",
  "description": "A library for creating charts",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./animation": {
      "types": "./dist/families/animation.d.ts",
      "import": "./dist/animation.js"
    },
    "./color": {
      "types": "./dist/families/color.d.ts",
      "import": "./dist/color.js"
    },
    "./coord": {
      "types": "./dist/families/coord.d.ts",
      "import": "./dist/coord.js"
    },
    "./curve": {
      "types": "./dist/families/curve.d.ts",
      "import": "./dist/curve.js"
    },
    "./overlap": {
      "types": "./dist/families/overlap.d.ts",
      "import": "./dist/overlap.js"
    },
    "./tile": {
      "types": "./dist/families/tile.d.ts",
      "import": "./dist/tile.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "charts",
    "graphics",
    "visualization",
    "solid-js",
    "typescript"
  ],
  "author": "Josh Pollock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gofish-graphics/gofish-graphics"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build:bench": "vite build --mode bench",
    "serve": "vite preview",
    "prepublishOnly": "pnpm run build",
    "fetch-titanic-passengers": "node scripts/fetch-titanic-passengers.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "pnpm run test:path && pnpm run test:interpolate && pnpm run test:spline && pnpm run test:time-window && pnpm run test:font && pnpm run test:bbox && pnpm run test:solver && pnpm run test:space && pnpm run test:measure && pnpm run test:geometry && pnpm run test:embedding && pnpm run test:confluence && pnpm run test:coord-confluence && pnpm run test:coord-paint-order && pnpm run test:compose && pnpm run test:serialize && pnpm run test:display-list && pnpm run test:interaction && pnpm run test:fusion && pnpm run test:default-split && pnpm run test:gapminder-tower && pnpm run test:connected-scatterplot && pnpm run test:build-schedule && pnpm run test:build-in-tower && pnpm run test:name-scope && pnpm run test:axis-dims && pnpm run test:relate-schedule && pnpm run test:auto-label-angle && pnpm run test:signed-extent && pnpm run test:schema && pnpm run test:stack-origin && pnpm run test:overlap && pnpm run test:families",
    "test:space": "tsx src/tests/space.test.ts",
    "test:measure": "tsx src/tests/measure.test.ts",
    "test:geometry": "tsx src/tests/geometry.test.ts",
    "test:embedding": "tsx src/tests/embedding.test.ts",
    "test:solver": "tsx src/tests/solver.test.ts",
    "test:confluence": "tsx src/tests/constraintConfluence.test.ts",
    "test:coord-confluence": "tsx src/tests/coordConfluence.test.ts",
    "test:coord-paint-order": "tsx src/tests/coordPaintOrder.test.ts",
    "test:compose": "tsx src/tests/compose.test.ts",
    "test:display-list": "pnpm run build && tsx src/tests/displayListEmit.test.ts",
    "test:path": "tsx src/tests/path.test.ts",
    "test:interpolate": "tsx src/tests/interpolate.test.ts",
    "test:spline": "tsx src/tests/spline.test.ts",
    "test:time-window": "tsx src/tests/timeWindow.test.ts",
    "test:font": "tsx src/tests/fontUtils.test.ts",
    "test:bbox": "tsx src/tests/bbox.test.ts",
    "test:serialize": "pnpm run build && tsx src/tests/serialize.test.ts",
    "test:fusion": "pnpm run build && tsx src/tests/fusion.test.ts",
    "test:default-split": "pnpm run build && tsx src/tests/defaultSplit.test.ts",
    "test:interaction": "pnpm run build && node --conditions browser --import tsx src/tests/interaction.test.ts",
    "test:gapminder-tower": "pnpm run build && node --conditions browser --import tsx src/tests/gapminderTower.test.ts",
    "test:connected-scatterplot": "pnpm run build && node --conditions browser --import tsx src/tests/connectedScatterplot.test.ts",
    "test:build-schedule": "tsx src/tests/buildSchedule.test.ts",
    "test:build-in-tower": "pnpm run build && node --conditions browser --import tsx src/tests/buildInTower.test.ts",
    "test:name-scope": "pnpm run build && tsx src/tests/nameScope.test.ts",
    "test:axis-dims": "pnpm run build && tsx src/tests/axisDims.test.ts",
    "test:relate-schedule": "tsx src/tests/relateSchedule.test.ts",
    "test:signed-extent": "pnpm run build && tsx src/tests/signedExtent.test.ts",
    "test:schema": "pnpm run build && tsx src/tests/schema.test.ts",
    "test:stack-origin": "pnpm run build && tsx src/tests/stackOrigin.test.ts",
    "test:overlap": "pnpm run build && tsx src/tests/overlap.test.ts",
    "test:families": "pnpm run build && tsx src/tests/families.test.ts",
    "test:auto-label-angle": "tsx src/tests/autoLabelAngle.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.6",
    "@storybook/html": "^9.1.6",
    "@storybook/react": "^9.1.6",
    "@types/culori": "^4.0.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/lodash": "^4.17.16",
    "@types/topojson-client": "^3.1.5",
    "fast-kde": "^0.2.2",
    "happy-dom": "^20.10.6",
    "prettier": "^3.6.2",
    "storybook": "^9.1.6",
    "storybook-solidjs-vite": "^9.0.3",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vega-datasets": "^3.2.1",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.1",
    "vite-plugin-solid": "^2.11.6"
  },
  "dependencies": {
    "@types/d3-array": "^3.2.1",
    "bubblesets-js": "^3.0.0",
    "culori": "^4.0.2",
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "gofish-ir": "workspace:*",
    "lodash": "^4.17.21",
    "perfect-arrows": "^0.3.7",
    "rybitten": "^0.22.0",
    "solid-js": "^1.9.5",
    "spectral.js": "^2.0.2"
  },
  "peerDependencies": {
    "solid-js": "^1.9.5"
  }
}
